DATABASE_URL=postgres://carelink:carelink@127.0.0.1:5432/carelink
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=dev-only-change-me
PORT=3000
# docs/02 §2 — 값을 바꾸려면 문서를 먼저 고칠 것
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
# 발급된 인증번호를 API 응답(devCode)에 실어 로그인 화면에 띄웁니다.
# **인증 우회 스위치입니다** — 켜면 전화번호만 아는 사람이 남의 계정으로
# 로그인합니다. 데모·로컬 전용이고, 운영에는 절대 넣지 마세요.
# 설정하지 않으면 NODE_ENV를 따릅니다 (production이면 닫힘).
# 켜져 있으면 API가 부팅 로그에 경고를 찍습니다.
AUTH_EXPOSE_OTP_CODE=true
